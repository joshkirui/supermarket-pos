{
  "name": "pos-system-kenya",
  "version": "1.0.0",
  "description": "POS System - Kenyan Supermarket",
  "main": "electron/main.js",
  "author": "Joshua Kirui",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "vite build && electron-builder --win",
    "electron:build:all": "vite build && electron-builder --win --mac --linux",
    "package": "electron-builder build --win --config electron-builder.json"
  },
  "build": {
    "appId": "com.pos.kenya",
    "productName": "POS System Kenya",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "public/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "POS-System-Kenya-${version}-portable.exe"
    }
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "zustand": "^4.5.4",
    "recharts": "^2.12.7",
    "axios": "^1.7.4",
    "date-fns": "^3.6.0",
    "react-hot-toast": "^2.4.1",
    "lucide-react": "^0.400.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "concurrently": "^8.2.2",
    "wait-on": "^7.2.0",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3"
  }
}
